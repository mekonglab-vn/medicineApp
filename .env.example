# ==============================================================================
# MedicineApp — Root Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env at the root of the repository:
#   cp .env.example .env
# ==============================================================================

# ── PostgreSQL Database ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=medicine_app
POSTGRES_PORT=5432

# ── Python AI Proxy (FastAPI) ──
PYTHON_PORT=8000
DEVICE=cpu

# ── Node.js API Gateway (Express) ──
NODE_PORT=3000
NODE_ENV=development

# ── Security & Authentication ──
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
