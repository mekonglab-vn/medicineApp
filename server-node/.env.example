# MedicineApp Server — Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://medicineapp:replace-with-a-local-password@localhost:5432/medicineapp

# JWT
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Python FastAPI (AI Pipeline)
PYTHON_API_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# File Upload
MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=info
