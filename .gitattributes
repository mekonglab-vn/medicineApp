# ==============================================================================
# Git Attributes Configuration for MedicineApp
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Default Handling
# ------------------------------------------------------------------------------
# Auto-detect text files and normalize line endings to LF in repository
* text=auto eol=lf

# ------------------------------------------------------------------------------
# 2. Source Code & Scripts (LF Line Endings)
# ------------------------------------------------------------------------------
# Dart & Flutter
*.dart text eol=lf
*.arb text eol=lf

# Python
*.py text eol=lf
*.pyi text eol=lf

# JavaScript / TypeScript / Node.js
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf

# Kotlin / Java / Android
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf

# C / C++ / CMake / Native
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Web, Config & Markup
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.lock text eol=lf

# Documentation & Text Data
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.sql text eol=lf

# Git & Docker configs
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf
Dockerfile text eol=lf

# Shell Scripts (MUST have LF to execute correctly on Unix/Linux)
*.sh text eol=lf
gradlew text eol=lf

# Windows Batch / Command Scripts (MUST have CRLF for cmd.exe)
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# ------------------------------------------------------------------------------
# 3. Binary Assets & Media (Raw Binary - No End-of-Line Conversion)
# ------------------------------------------------------------------------------
# Image formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.tiff binary

# AI Model Weights, Checkpoints & Serialized Graphs
*.pt binary
*.pth binary
*.bin binary
*.onnx binary
*.tflite binary
*.pb binary
*.h5 binary
*.pkl binary
*.pickle binary
*.joblib binary
*.safetensors binary

# Document Formats & Compressed Archives
*.pdf binary
*.docx binary
*.doc binary
*.xlsx binary
*.pptx binary
*.zip binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.tar.bz2 binary
*.rar binary
*.7z binary
*.jar binary

# Fonts & Compiled Binaries
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.a binary
*.class binary

# ------------------------------------------------------------------------------
# 4. GitHub Linguist Overrides (Repository Language Breakdown & Categorization)
# ------------------------------------------------------------------------------
# Large databases & dataset logs (treat as generated/vendored to avoid skewing repo stats)
data/drug_db_vn_full.json linguist-generated=true
data/vaipe_drugs_kb.json linguist-generated=true
data/human_verification_provenance_log.json linguist-generated=true
reports/** linguist-generated=true

# Generated Flutter localization files
mobile/lib/l10n/app_localizations*.dart linguist-generated=true

# Gradle wrappers & vendor scripts
mobile/android/gradlew linguist-vendored=true
mobile/android/gradlew.bat linguist-vendored=true
mobile/android/gradle/wrapper/gradle-wrapper.jar linguist-vendored=true

# Documentation directories
docs/** linguist-documentation=true
